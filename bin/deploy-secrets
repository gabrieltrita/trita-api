#!/usr/bin/env ruby
require "optparse"
require_relative "../lib/deploy_secrets"

options = {}
parser = OptionParser.new do |opts|
  opts.banner = "Usage: bin/deploy-secrets staging|production HOST [--repo OWNER/NAME] [--force]"
  opts.on("--repo REPOSITORY", "Repository that receives the secrets (default: the current one)") { |value| options[:repository] = value }
  opts.on("--force", "Replace secrets that are already set") { options[:force] = true }
end

begin
  environment, host = parser.parse!(ARGV)
  abort(parser.help) unless environment && host

  secrets = DeploySecrets.new(root: File.expand_path("..", __dir__), environment: environment, host: host, **options)
  result = secrets.call
  puts "Stored #{result.names.size} secrets: #{result.names.join(", ")}"
  puts "", "Host key of #{host}: #{result.host_fingerprint}", "Compare it with `ssh-keygen -lf /etc/ssh/ssh_host_ed25519_key.pub` on the server before the first deploy."
  puts "", "Append this line to ~/.ssh/authorized_keys of the deploy user on #{host}:", result.public_key
  puts "", "Still yours to set: #{DeploySecrets::PROVIDED_BY_YOU.map { |name| secrets.prefix + name }.join(", ")}"
rescue DeploySecrets::Error, OptionParser::ParseError => error
  abort "bin/deploy-secrets: #{error.message}"
end
